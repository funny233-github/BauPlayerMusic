# BauPlayerMusic DDNet 服务端
# 先构建编译环境：docker compose build build-env

# 阶段 1: 编译 DDNet-Server
FROM bpmusic-build:latest AS builder
WORKDIR /build
COPY . .
RUN cmake -S . -B build-server \
    -DCLIENT=OFF \
    -DWEBSOCKETS=OFF \
    -DMYSQL=OFF \
    -DPREFER_BUNDLED_LIBS=ON \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_FLAGS="-static-libgcc -static-libstdc++" \
    && cmake --build build-server --config Release --target game-server music_map_patcher -- -j$(nproc) \
    && strip build-server/DDNet-Server build-server/music_map_patcher

# 阶段 2: DDNet 运行时（只有运行库，无 python/rust）
FROM ubuntu:latest
WORKDIR /app

ARG APT_MIRROR=""
COPY --from=builder /build/build-server/DDNet-Server /usr/local/bin/
COPY --from=builder /build/build-server/music_map_patcher /usr/local/bin/
COPY data/ data/
COPY storage.cfg .
COPY docker-entrypoint-server.sh .

RUN if [ -n "${APT_MIRROR}" ]; then \
      sed -i "s|http://archive.ubuntu.com|${APT_MIRROR}|g; s|http://security.ubuntu.com|${APT_MIRROR}|g" /etc/apt/sources.list.d/ubuntu.sources \
      || sed -i "s|http://archive.ubuntu.com|${APT_MIRROR}|g; s|http://security.ubuntu.com|${APT_MIRROR}|g" /etc/apt/sources.list; \
    fi \
    && apt-get update && apt-get install -y --no-install-recommends \
    libcurl4t64 \
    libfreetype6 \
    libopus0 \
    libopusfile0 \
    libsdl2-2.0-0 \
    libsqlite3-0 \
    libssl3t64 \
    libwavpack1 \
    libzstd1 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* \
    && rm -rf /usr/share/doc/* /usr/share/man/* /usr/share/locale/* \
    && chmod +x docker-entrypoint-server.sh

EXPOSE 8303/udp
ENTRYPOINT ["./docker-entrypoint-server.sh"]
