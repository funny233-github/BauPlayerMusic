# BauPlayerMusic Python 后端
# 先构建编译环境：docker compose build build-env

# 阶段 1: 编译 music_map_patcher
FROM bpmusic-build:latest AS builder
WORKDIR /build
COPY . .
RUN cmake -S . -B build-server \
    -DCLIENT=OFF \
    -DWEBSOCKETS=OFF \
    -DMYSQL=OFF \
    -DPREFER_BUNDLED_LIBS=ON \
    -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build-server --config Release --target music_map_patcher -- -j$(nproc) \
    && strip build-server/music_map_patcher

# 阶段 2: Python 运行时
FROM python:3.13-slim
WORKDIR /app

ARG APT_MIRROR=""
ARG PIP_MIRROR=""
COPY requirements.txt requirements-aliyun.txt ./
COPY --from=builder /build/build-server/music_map_patcher /usr/local/bin/
COPY mds.py admin_panel.py qqbot_bridge.py music_stats.py turtle_soup.py undercover_game.py ./
COPY admin_web/ admin_web/
COPY data/originmaps/ data/originmaps/
COPY data/musico/turtle_soup_cases.json data/musico/undercover_words.txt data/musico/
COPY docker-entrypoint-backend.sh .

RUN if [ -n "${APT_MIRROR}" ]; then \
      sed -i "s|http://deb.debian.org|${APT_MIRROR}|g; s|http://security.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources; \
    fi \
    && apt-get update && apt-get install -y --no-install-recommends ffmpeg curl \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* \
    && rm -rf /usr/share/doc/* /usr/share/man/* /usr/share/locale/* \
    && pip install --no-cache-dir -r requirements-aliyun.txt ${PIP_MIRROR:+-i ${PIP_MIRROR}} \
    && find /usr/local/lib -name __pycache__ -type d -exec rm -rf {} + 2>/dev/null; true \
    && chmod +x docker-entrypoint-backend.sh \
    && mkdir -p data/musicso/covers data/musico/prepared_maps data/webmaps

EXPOSE 5000 8787
ENTRYPOINT ["./docker-entrypoint-backend.sh"]
